rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function myWardId() {
      return userDoc(request.auth.uid).wardMembership.wardId;
    }

    function sameWard(wardId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).wardMembership != null
        && myWardId() == wardId;
    }

    function isLeader() {
      return userDoc(request.auth.uid).wardMembership.isLeader == true;
    }

    // Perfiles completos: solo el propio usuario
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Tarjeta pública mínima por xTheGospel ID (amigos / QR)
    match /publicUserCards/{xtgId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'xthegospelId', 'displayName', 'photoURL', 'memberStatus', 'updatedAt'])
        && request.resource.data.xthegospelId == xtgId;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Solicitudes de amistad
    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(['fromUid', 'toUid', 'status', 'createdAt']);

      allow update: if signedIn() && (
        (resource.data.toUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'rejected'])
        || (resource.data.fromUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled')
      );

      allow delete: if false;
    }

    // Tema de estudio compartido (solo pares declarados en el documento)
    match /sharedStudy/{docId} {
      allow read: if signedIn()
        && (resource.data.participantUid1 == request.auth.uid
            || resource.data.participantUid2 == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.participantUid1 is string
        && request.resource.data.participantUid2 is string
        && request.resource.data.participantUid1 < request.resource.data.participantUid2
        && request.auth.uid in [request.resource.data.participantUid1, request.resource.data.participantUid2]
        && request.resource.data.keys().hasAll(['participantPairId', 'participantUid1', 'participantUid2', 'activeLessonId', 'updatedAt']);

      allow update: if signedIn()
        && (resource.data.participantUid1 == request.auth.uid
            || resource.data.participantUid2 == request.auth.uid);
    }

    // Mensajes entre dos usuarios (validación de amistad solo en cliente; endurecer con Cloud Function si hace falta)
    match /friendMessages/{msgId} {
      allow read: if signedIn()
        && (resource.data.participantUid1 == request.auth.uid
            || resource.data.participantUid2 == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.participantUid1 is string
        && request.resource.data.participantUid2 is string
        && request.resource.data.participantUid1 < request.resource.data.participantUid2
        && request.auth.uid in [request.resource.data.participantUid1, request.resource.data.participantUid2]
        && request.resource.data.keys().hasAll(['participantPairId', 'participantUid1', 'participantUid2', 'senderUid', 'text', 'createdAt']);

      allow update, delete: if false;
    }

    match /wards/{wardId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn();

      match /baptismPreparation/{memberId} {
        allow read, write: if sameWard(wardId) && isLeader();
      }

      match /teachingSessions/{sessionId} {
        allow read, write: if signedIn();

        match /participants/{participantId} {
          allow read, write: if signedIn();
        }

        match /feedback/{feedbackId} {
          allow read, write: if signedIn();
        }
      }
    }

    match /wardCodes/{code} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
  }
}
